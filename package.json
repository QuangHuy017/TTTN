{
  "name": "equipment-loan-system",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "build": "npm run build -w frontend",
    "test": "npm run test -w backend",
    "lint": "eslint ."
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "eslint": "^9.0.0",
    "@eslint/js": "^9.0.0",
    "globals": "^16.0.0",
    "eslint-plugin-react-hooks": "^5.2.0"
  }
}